params {
    help = false
    start_from = 'prepared'
    data_dir = "${projectDir}/results/g4_methylation_age_quadron_100bp"
    outdir = "${projectDir}/results/paper"
    probe_manifest = "${projectDir}/../results/submission_v3/reference_manifest/probe_gene_manifest.csv.gz"
    expected_tables = "${projectDir}/G4_methylation_paper_files/data"
    verify = true

    // Existing Quadron windows are the default. Original class-separated BEDs
    // can rebuild them, but their labels/cutoffs must be supplied, not inferred.
    g4_stable = null
    g4_unstable = null
    series_matrix_dir = null
    sequence_flank_bp = 1000
    slurm_partition = 'norm'
}

process {
    cpus = 2
    memory = '8 GB'
    time = '6h'
    errorStrategy = 'terminate'

    withLabel: 'process_low' {
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }
}

profiles {
    standard {
        process.executor = 'local'
        // The genome and beta matrices are substantial. Serialize local jobs
        // rather than running both models and three large slope fits together.
        executor.queueSize = 1
    }

    slurm {
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        executor.queueSize = 50
        executor.submitRateLimit = '10 sec'
    }
}

// Nextflow owns task caching, exact .command.sh files, logs and execution
// provenance; these generated files stay under ignored run output/work dirs.
trace {
    enabled = true
    // Trace observers initialize before the workflow's output safety checks.
    // Keep this generated file outside outdir so a first run remains empty.
    file = "${projectDir}/.nextflow-paper-trace.txt"
    overwrite = true
}